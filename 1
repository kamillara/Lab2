s = 0
c = 0
n = int(input("Введите число (каждое с новой строки), для окончания введите 0: "))
while n != 0:
    s += n
    c += 1
    n = int(input())
print("а) Сумма всех чисел последовательности: ", s)
print("б) Количество всех чисел последовательности: ", c)

n = int(input("Введите целое число: "))
k = 0
while 2 ** k <= n:
    k += 1
print("Наименьшее целое число K, при котором 2^K > N: ", k)
